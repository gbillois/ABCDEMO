+/**
+ * The retro look (added for « Les Trois Lueurs »): the diorama turned toward the 16-bit consoles —
+ * a nearly flat depth of field (only a hint of blur at the very top and bottom of the frame), a soft
+ * bloom, bright saturated colours with little teal in the shade, no grain, no vignette to speak of,
+ * no chromatic aberration; and a coarser drawing buffer shown with `image-rendering: pixelated`
+ * (`RETRO_PIXEL_RATIO`, Game), so the whole frame reads as big crisp pixels.
+ */
+export const RETRO_LOOK = Object.freeze({
+  dof: { focusRange: 14, maxBlur: 3, nearScale: 0.5, farScale: 0.4, tiltShift: 0.12, tiltCenter: 0.5, tiltWidth: 0.6, bokehBoost: 1.0 },
+  bloom: { strength: 0.32, radius: 0.45, threshold: 1.15, warmth: 0.15 },
+  grade: {
+    exposure: 1.06, contrast: 1.1, saturation: 1.3, temperature: 0.02,
+    vignette: 0.18, grain: 0, chromaticAberration: 0,
+    shadowsTint: [-0.01, 0.02, 0.06], highlightsTint: [0.04, 0.03, -0.01],
+  },
+});
+
+/** The drawing buffer's pixels per CSS pixel on the retro look (the frame is drawn coarse, then scaled up crisp). */
+export const RETRO_PIXEL_RATIO = 0.5;
+
+/**
+ * Write the retro look into PostFX's settings (on top of the diorama values already there).
+ * @param {PostFX['settings']} S
+ */
+export function applyRetroLook(S) {
+  for (const group of /** @type {const} */ (['dof', 'bloom', 'grade'])) {
+    const dst = S[group];
+    for (const [k, v] of Object.entries(RETRO_LOOK[group])) dst[k] = Array.isArray(v) ? [...v] : v;
+  }
+}
+
 /** What `applyLevelLook` wrote last into a page's settings (`applyStateLook` compares with it). */
 const APPLIED = new WeakMap();
 
